{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ReproCrate",
  "version": "0.9.0",
  "identifier": "dev.sanskarin.reprocrate",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ReproCrate — Diagnostic Workspace",
        "width": 1180,
        "height": 780,
        "minWidth": 860,
        "minHeight": 620,
        "backgroundColor": "#101622"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost",
      "capabilities": [
        "main"
      ]
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
